#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$0"
while [ -L "$SCRIPT_PATH" ]; do
  SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
  SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
  case "$SCRIPT_PATH" in /*) ;; *) SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH" ;; esac
done
REPO_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
CONFIGURE_KIT_DIR="${OMP_SBX_CONFIGURE_KIT:-$REPO_DIR/sbx-configure-kit}"
DEFAULT_CONFIGURE_TEMPLATE="omp-sbx-configure:latest"
TEMPLATE="${OMP_SBX_CONFIGURE_TEMPLATE:-$DEFAULT_CONFIGURE_TEMPLATE}"
CONFIGURE_OMP_VERSION="${OMP_SBX_CONFIGURE_OMP_VERSION:-18.1.10}"

if [ -t 2 ]; then
  C_DIM=$'\033[2m'; C_CYAN=$'\033[36m'; C_GREEN=$'\033[32m'
  C_YELLOW=$'\033[33m'; C_RED=$'\033[31m'; C_BOLD=$'\033[1m'; C_RST=$'\033[0m'
else
  C_DIM=''; C_CYAN=''; C_GREEN=''; C_YELLOW=''; C_RED=''; C_BOLD=''; C_RST=''
fi
log() { printf '%s\n' "$*" >&2; }
usage() {
  cat >&2 <<'EOF'
Usage: omp --configure [--fast SELECTOR[:LEVEL]] [--standard SELECTOR[:LEVEL]] [--deep SELECTOR[:LEVEL]] [--dry-run]

Levels: inherit, off, minimal, low, medium, high, xhigh, max.
Concrete levels must be supported by the discovered model.
Bare selectors and :inherit use native inheritance; :off requests disabled thinking.
EOF
}
usage_error() {
  log "${C_RED}omp-sbx-configure-models: $1${C_RST}"
  usage
  exit 2
}

FAST_SELECTOR=""
STANDARD_SELECTOR=""
DEEP_SELECTOR=""
DRY_RUN=false
while [ "$#" -gt 0 ]; do
  case "$1" in
    --fast|--standard|--deep)
      flag="$1"
      if [ "$#" -lt 2 ] || [[ "$2" == --* ]]; then
        usage_error "missing value for $flag"
      fi
      case "$flag" in
        --fast) FAST_SELECTOR="$2" ;;
        --standard) STANDARD_SELECTOR="$2" ;;
        --deep) DEEP_SELECTOR="$2" ;;
      esac
      shift 2
      ;;
    --dry-run)
      DRY_RUN=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *) usage_error "unknown option: $1" ;;
  esac
done

if { [ -z "$FAST_SELECTOR" ] || [ -z "$STANDARD_SELECTOR" ] || [ -z "$DEEP_SELECTOR" ]; } && [ ! -t 0 ]; then
  usage_error "all three tiers are required without an interactive terminal"
fi

# shellcheck source=sbx-preflight.sh
source "$REPO_DIR/sbx-preflight.sh"
ensure_sbx "omp-sbx-configure-models"

if [ ! -d "$HOME/.omp" ]; then
  log "${C_RED}omp-sbx-configure-models: host config dir not found: $HOME/.omp${C_RST}"
  exit 1
fi
if ! command -v python3 >/dev/null 2>&1; then
  log "${C_RED}omp-sbx-configure-models: python3 is required${C_RST}"
  exit 1
fi

SANDBOX_NAME="omp-configure-models-$$"
CONFIG_CWD="/var/tmp/$SANDBOX_NAME"
CAPTURE_DIR="$(mktemp -d)"
cleanup() {
  sbx rm -f "$SANDBOX_NAME" >/dev/null 2>&1 || true
  if [ -n "${HOST_CONFIG_TEMP:-}" ]; then
    rm -f "$HOST_CONFIG_TEMP"
  fi
  rm -rf "$CAPTURE_DIR"
}
trap cleanup EXIT

# Capture inside a writable guest mount. Some sbx exec versions can close the
# non-interactive attach stream before the guest command exits, so a sidecar
# published by the guest is the completion boundary rather than sbx exec.
CAPTURE_WAIT_ATTEMPTS=1200
capture_sandbox_stdout() {
  local destination="$1" partial status_partial status_file
  local transport_status remote_status normalized_status attempts=0
  shift
  partial="${destination}.partial"
  status_partial="${destination}.status.partial"
  status_file="${destination}.status"
  rm -f "$destination" "$partial" "$status_partial" "$status_file"

  if sbx exec -w "$CONFIG_CWD" "$SANDBOX_NAME" -- \
    sh -c '
      destination=$1
      partial=$2
      status_partial=$3
      status_file=$4
      shift 4
      cleanup_unpublished_capture() {
        rm -f "$partial" "$status_partial" || true
      }
      trap cleanup_unpublished_capture EXIT
      trap "exit 125" HUP INT TERM

      if "$@" > "$partial"; then
        command_status=0
        if ! mv -f "$partial" "$destination"; then
          command_status=125
          rm -f "$partial" "$destination" || true
        fi
      else
        command_status=$?
        rm -f "$partial" "$destination" || true
      fi

      if ! printf "%s\n" "$command_status" > "$status_partial"; then
        rm -f "$status_partial" "$status_file" || true
        exit 125
      fi
      if ! mv -f "$status_partial" "$status_file"; then
        rm -f "$status_partial" "$status_file" || true
        exit 125
      fi
      trap - EXIT HUP INT TERM
      exit "$command_status"
    ' sh "$destination" "$partial" "$status_partial" "$status_file" "$@"
  then
    transport_status=0
  else
    transport_status=$?
  fi

  while [ ! -e "$status_file" ]; do
    if [ "$attempts" -ge "$CAPTURE_WAIT_ATTEMPTS" ]; then
      log "${C_RED}omp-sbx-configure-models: timed out waiting for sandbox capture completion: ${destination##*/}${C_RST}"
      rm -f "$destination" "$partial" "$status_partial" "$status_file" || true
      if [ "$transport_status" -ne 0 ]; then
        return "$transport_status"
      fi
      return 124
    fi
    sleep 0.1
    attempts=$((attempts + 1))
  done

  remote_status=""
  if ! remote_status="$(cat "$status_file")"; then
    remote_status=""
  fi
  case "$remote_status" in
    ''|*[!0-9]*)
      log "${C_RED}omp-sbx-configure-models: invalid sandbox capture status: ${destination##*/}${C_RST}"
      rm -f "$destination" "$partial" "$status_partial" "$status_file" || true
      return 125
      ;;
  esac
  normalized_status="$remote_status"
  while [ "${normalized_status#0}" != "$normalized_status" ]; do
    normalized_status="${normalized_status#0}"
  done
  [ -n "$normalized_status" ] || normalized_status=0
  case "$normalized_status" in
    [0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5]) ;;
    *)
      log "${C_RED}omp-sbx-configure-models: invalid sandbox capture status: ${destination##*/}${C_RST}"
      rm -f "$destination" "$partial" "$status_partial" "$status_file" || true
      return 125
      ;;
  esac

  if [ "$transport_status" -ne 0 ] &&
     { [ "$normalized_status" -eq 0 ] || [ "$transport_status" -ne "$normalized_status" ]; }
  then
    log "${C_RED}omp-sbx-configure-models: sandbox transport and command status disagree${C_RST}"
    rm -f "$destination" "$partial" "$status_partial" "$status_file" || true
    return 125
  fi
  if [ "$normalized_status" -ne 0 ]; then
    rm -f "$destination" "$partial" "$status_partial" "$status_file" || true
    return "$normalized_status"
  fi

  while [ ! -s "$destination" ]; do
    if [ "$attempts" -ge "$CAPTURE_WAIT_ATTEMPTS" ]; then
      log "${C_RED}omp-sbx-configure-models: sandbox command completed without captured output: ${destination##*/}${C_RST}"
      rm -f "$destination" "$partial" "$status_partial" "$status_file" || true
      return 125
    fi
    sleep 0.1
    attempts=$((attempts + 1))
  done

  rm -f "$partial" "$status_partial" "$status_file" || true
}

sbx rm -f "$SANDBOX_NAME" >/dev/null 2>&1 || true
log "${C_DIM}Discovering models in disposable sandbox ${SANDBOX_NAME}...${C_RST}"
create_configure_sandbox() {
  sbx create -q --template "$TEMPLATE" --name "$SANDBOX_NAME" \
    "$CONFIGURE_KIT_DIR" /tmp "$HOME/.omp" "$CAPTURE_DIR"
}
CREATE_OUTPUT=""
if ! CREATE_OUTPUT="$(create_configure_sandbox 2>&1)"; then
  case "$CREATE_OUTPUT" in
    *"pull failed"*|*"403 Forbidden"*|*"sandbox container exited with code 1 immediately after start"*)
      if [ "$TEMPLATE" = "$DEFAULT_CONFIGURE_TEMPLATE" ]; then
        log "${C_YELLOW}Local configure template is missing or stale; building it once...${C_RST}"
        if ! OMP_VERSION="$CONFIGURE_OMP_VERSION" \
             OMP_SBX_CONFIGURE_IMAGE="$TEMPLATE" \
             "$REPO_DIR/build-configure.sh"
        then
          log "$CREATE_OUTPUT"
          exit 1
        fi
        sbx rm -f "$SANDBOX_NAME" >/dev/null 2>&1 || true
        if ! CREATE_OUTPUT="$(create_configure_sandbox 2>&1)"; then
          log "$CREATE_OUTPUT"
          exit 1
        fi
      else
        log "$CREATE_OUTPUT"
        exit 1
      fi
      ;;
    *)
      log "$CREATE_OUTPUT"
      exit 1
      ;;
  esac
fi
if [ -n "$CREATE_OUTPUT" ]; then
  log "$CREATE_OUTPUT"
fi
sleep 2
sbx exec -w /home/agent "$SANDBOX_NAME" -- mkdir -m 700 "$CONFIG_CWD"
HOST_OMP_DIR="$(realpath "$HOME/.omp")"
HOST_CONFIG_DIR="$HOST_OMP_DIR/agent"
HOST_CONFIG_FILE="$HOST_CONFIG_DIR/config.yml"
MOUNTED_AGENT_DIR="$HOME/.omp/agent"
STAGED_AGENT_DIR="$CAPTURE_DIR/staged-agent"
STAGED_CONFIG_FILE="$STAGED_AGENT_DIR/config.yml"
mkdir -m 700 "$STAGED_AGENT_DIR"
if [ -f "$HOST_CONFIG_FILE" ]; then
  cp "$HOST_CONFIG_FILE" "$STAGED_CONFIG_FILE"
  chmod 0600 "$STAGED_CONFIG_FILE"
fi
capture_staged_config() {
  local destination="$1"
  shift
  capture_sandbox_stdout "$destination" \
    env "PI_CODING_AGENT_DIR=$STAGED_AGENT_DIR" omp config "$@"
}
set_staged_config() {
  sbx exec -w "$CONFIG_CWD" "$SANDBOX_NAME" -- \
    env "PI_CODING_AGENT_DIR=$STAGED_AGENT_DIR" omp config set "$@"
}

CATALOG_RAW="$CAPTURE_DIR/models.raw.json"
CATALOG="$CAPTURE_DIR/models.json"
MENU_RECORDS="$CAPTURE_DIR/models.menu"
capture_sandbox_stdout "$CATALOG_RAW" \
  env "PI_CODING_AGENT_DIR=$MOUNTED_AGENT_DIR" omp models --json
python3 - "$CATALOG_RAW" "$CATALOG" "$MENU_RECORDS" <<'PY'
import json
import sys

source, destination, menu_destination = sys.argv[1:]
try:
    with open(source, encoding="utf-8") as stream:
        payload = json.load(stream)
except (OSError, json.JSONDecodeError) as error:
    raise SystemExit(f"malformed models output: {error}")
models = payload.get("models") if isinstance(payload, dict) else None
if not isinstance(models, list) or not models:
    raise SystemExit("malformed models output: .models must be a non-empty array")
normalized = []
efforts = ("minimal", "low", "medium", "high", "xhigh", "max")
for index, model in enumerate(models):
    if not isinstance(model, dict):
        raise SystemExit(f"malformed models output: .models[{index}] must be an object")
    entry = {}
    for field in ("selector", "provider", "name"):
        value = model.get(field)
        if not isinstance(value, str) or not value:
            raise SystemExit(f"malformed models output: .models[{index}].{field} must be a non-empty string")
        entry[field] = value
    reasoning = model.get("reasoning")
    if not isinstance(reasoning, bool):
        raise SystemExit(f"malformed models output: .models[{index}].reasoning must be a boolean")
    thinking = model.get("thinking")
    if "thinking" not in model or (thinking is not None and (
        not isinstance(thinking, list)
        or any(not isinstance(level, str) or level not in efforts for level in thinking)
        or len(set(thinking)) != len(thinking)
        or (thinking and not reasoning)
    )):
        raise SystemExit(f"malformed models output: .models[{index}].thinking must be null or unique supported effort names")
    entry["reasoning"] = reasoning
    entry["thinking"] = thinking
    normalized.append(entry)
normalized.sort(key=lambda item: (item["provider"], item["name"], item["selector"]))
with open(destination, "w", encoding="utf-8") as stream:
    json.dump(normalized, stream, separators=(",", ":"))
with open(menu_destination, "w", encoding="utf-8") as stream:
    for model in normalized:
        label = f"{model['provider']} — {model['name']} ({model['selector']})"
        supported = ",".join(level for level in efforts if level in (model["thinking"] or []))
        stream.write(f"{model['selector']}\x1e{label}\x1e{supported}\n")
PY
MODEL_SELECTORS=()
MODEL_LABELS=()
MODEL_THINKING=()
while IFS=$'\x1e' read -r selector label thinking; do
  MODEL_SELECTORS+=("$selector")
  MODEL_LABELS+=("$label")
  MODEL_THINKING+=("$thinking")
done < "$MENU_RECORDS"


selector_index() {
  local sought="$1" index
  for ((index = 0; index < ${#MODEL_SELECTORS[@]}; index++)); do
    if [ "${MODEL_SELECTORS[index]}" = "$sought" ]; then
      printf '%s\n' "$index"
      return 0
    fi
  done
  return 1
}
MODEL_COUNT="${#MODEL_SELECTORS[@]}"

validate_thinking_choice() {
  local thinking_base="$1" thinking_level="$2" thinking_index
  thinking_index="$(selector_index "$thinking_base")" || return 1
  case "$thinking_level" in
    inherit) return 0 ;;
    off) ;;
    minimal|low|medium|high|xhigh|max)
      if [[ ",${MODEL_THINKING[thinking_index]}," != *",$thinking_level,"* ]]; then
        log "${C_RED}omp-sbx-configure-models: thinking level $thinking_level is not supported by $thinking_base${C_RST}"
        return 1
      fi
      ;;
    *) return 1 ;;
  esac
  if selector_index "$thinking_base:$thinking_level" >/dev/null; then
    log "${C_RED}omp-sbx-configure-models: thinking selector conflicts with an available model: $thinking_base:$thinking_level${C_RST}"
    return 1
  fi
}
parse_configured_selector() {
  local parsed_tier="$1" parsed_input="$2" parsed_result="$3" parsed_base_result="$4"
  local parsed_base="$parsed_input" parsed_level=inherit
  if ! selector_index "$parsed_input" >/dev/null; then
    parsed_base="${parsed_input%:*}"
    parsed_level="${parsed_input##*:}"
    if [[ "$parsed_input" != *:* ]] || ! selector_index "$parsed_base" >/dev/null; then
      log "${C_RED}omp-sbx-configure-models: invalid $parsed_tier selector: $parsed_input${C_RST}"
      return 1
    fi
    case "$parsed_level" in
      inherit|off|minimal|low|medium|high|xhigh|max) ;;
      *)
        log "${C_RED}omp-sbx-configure-models: invalid $parsed_tier selector: $parsed_input${C_RST}"
        return 1
        ;;
    esac
    validate_thinking_choice "$parsed_base" "$parsed_level" || return 1
  fi
  if [ "$parsed_level" = inherit ]; then
    printf -v "$parsed_result" '%s' "$parsed_base"
  else
    printf -v "$parsed_result" '%s' "$parsed_base:$parsed_level"
  fi
  printf -v "$parsed_base_result" '%s' "$parsed_base"
}
clear_selector_menu() {
  local line_count="$1" line
  printf '\033[%dA\r' "$line_count" >/dev/tty
  for ((line = 0; line < line_count; line++)); do
    printf '\033[2K' >/dev/tty
    if [ "$line" -lt $((line_count - 1)) ]; then
      printf '\033[1B\r' >/dev/tty
    fi
  done
  if [ "$line_count" -gt 1 ]; then
    printf '\033[%dA' "$((line_count - 1))" >/dev/tty
  fi
  printf '\r' >/dev/tty
}
render_choice_menu() {
  local label="$1" selected_index="$2" viewport_start="$3" viewport_size="$4" optional="$5"
  shift 5
  local labels=("$@")
  local count="${#labels[@]}" viewport_end=$((viewport_start + viewport_size)) index
  if [ "$viewport_end" -gt "$count" ]; then
    viewport_end="$count"
  fi
  if [ "$count" -gt "$viewport_size" ]; then
    printf '%s%s (%d-%d of %d)%s\n' \
      "${C_BOLD}${C_CYAN}" "$label" "$((viewport_start + 1))" "$viewport_end" "$count" "$C_RST" >/dev/tty
  else
    printf '%s%s%s\n' "${C_BOLD}${C_CYAN}" "$label" "$C_RST" >/dev/tty
  fi
  local skip_help=""
  if [ "$optional" = true ]; then skip_help=' · s skip'; fi
  printf '%s↑/↓ move · Enter select%s · q/Esc cancel%s\n' "$C_DIM" "$skip_help" "$C_RST" >/dev/tty
  for ((index = viewport_start; index < viewport_end; index++)); do
    if [ "$index" -eq "$selected_index" ]; then
      printf '%s> %s%s\n' "$C_CYAN" "${labels[index]}" "$C_RST" >/dev/tty
    else
      printf '  %s\n' "${labels[index]}" >/dev/tty
    fi
  done
}
prompt_choice() {
  local label="$1" preferred="$2" result_variable="$3" optional="$4" count="$5"
  shift 5
  local values=("${@:1:count}")
  shift "$count"
  local labels=("$@")
  local selected_index=0 index viewport_start=0
  local viewport_size="$count" rendered_lines key sequence direction
  for ((index = 0; index < count; index++)); do
    if [ "${values[index]}" = "$preferred" ]; then
      selected_index="$index"
      break
    fi
  done
  if [ "$viewport_size" -gt 12 ]; then
    viewport_size=12
  fi
  if [ "$selected_index" -ge "$viewport_size" ]; then
    viewport_start=$((selected_index - viewport_size + 1))
  fi
  rendered_lines=$((viewport_size + 2))
  render_choice_menu "$label" "$selected_index" "$viewport_start" "$viewport_size" "$optional" "${labels[@]}"
  while true; do
    key=""
    if ! IFS= read -rsn1 key </dev/tty; then
      clear_selector_menu "$rendered_lines"
      log "${C_RED}omp-sbx-configure-models: failed to read from terminal${C_RST}"
      exit 1
    fi
    direction=""
    case "$key" in
      '')
        clear_selector_menu "$rendered_lines"
        printf -v "$result_variable" '%s' "${values[selected_index]}"
        return 0
        ;;
      s)
        if [ "$optional" != true ]; then continue; fi
        clear_selector_menu "$rendered_lines"
        printf -v "$result_variable" '%s' ""
        return 0
        ;;
      q)
        clear_selector_menu "$rendered_lines"
        log "${C_DIM}cancelled${C_RST}"
        exit 0
        ;;
      k)
        direction=up
        ;;
      j)
        direction=down
        ;;
      $'\033')
        sequence=""
        if ! IFS= read -rsn2 -t 0.1 sequence </dev/tty; then
          :
        fi
        case "$sequence" in
          '[A'|'OA') direction=up ;;
          '[B'|'OB') direction=down ;;
          '')
            clear_selector_menu "$rendered_lines"
            log "${C_DIM}cancelled${C_RST}"
            exit 0
            ;;
          *) continue ;;
        esac
        ;;
      *) continue ;;
    esac
    if [ "$direction" = up ]; then
      selected_index=$(((selected_index - 1 + count) % count))
    else
      selected_index=$(((selected_index + 1) % count))
    fi
    if [ "$selected_index" -lt "$viewport_start" ]; then
      viewport_start="$selected_index"
    elif [ "$selected_index" -ge $((viewport_start + viewport_size)) ]; then
      viewport_start=$((selected_index - viewport_size + 1))
    fi
    clear_selector_menu "$rendered_lines"
    render_choice_menu "$label" "$selected_index" "$viewport_start" "$viewport_size" "$optional" "${labels[@]}"
  done
}
prompt_thinking() {
  local thinking_tier="$1" thinking_model="$2" thinking_result="$3"
  local capability_index chosen_thinking="" effort
  local thinking_values=(inherit off)
  local thinking_labels=("Inherit (no role-specific override)" "Off (native disable request)")
  capability_index="$(selector_index "$thinking_model")"
  if [ -z "${MODEL_THINKING[capability_index]}" ]; then
    log "No configurable thinking effort levels advertised for $thinking_model."
  else
    local supported_efforts=()
    IFS=, read -r -a supported_efforts <<< "${MODEL_THINKING[capability_index]}"
    for effort in "${supported_efforts[@]}"; do
      thinking_values+=("$effort")
      thinking_labels+=("$effort")
    done
  fi
  while true; do
    prompt_choice "Select $thinking_tier thinking level" inherit chosen_thinking false "${#thinking_values[@]}" \
      "${thinking_values[@]}" "${thinking_labels[@]}"
    if validate_thinking_choice "$thinking_model" "$chosen_thinking"; then
      printf -v "$thinking_result" '%s' "$chosen_thinking"
      return 0
    fi
  done
}
prompt_selector() {
  local tier="$1" preferred_model="$2" selector_result="$3" optional_model="${4:-false}"
  local selected_model="" selected_thinking=""
  prompt_choice "Select $tier model" "$preferred_model" selected_model "$optional_model" "$MODEL_COUNT" \
    "${MODEL_SELECTORS[@]}" "${MODEL_LABELS[@]}"
  if [ -n "$selected_model" ]; then
    prompt_thinking "$tier" "$selected_model" selected_thinking
    if [ "$selected_thinking" != inherit ]; then
      selected_model="$selected_model:$selected_thinking"
    fi
  fi
  printf -v "$selector_result" '%s' "$selected_model"
  printf '%s: %s\n' "$tier" "${selected_model:-skipped}" >/dev/tty
}

if [ -z "$FAST_SELECTOR" ]; then prompt_selector fast 'openai-codex/gpt-5.6-luna' FAST_SELECTOR; fi
parse_configured_selector fast "$FAST_SELECTOR" FAST_SELECTOR FAST_BASE_SELECTOR
if [ -z "$STANDARD_SELECTOR" ]; then prompt_selector standard 'openai-codex/gpt-5.6-sol' STANDARD_SELECTOR; fi
parse_configured_selector standard "$STANDARD_SELECTOR" STANDARD_SELECTOR STANDARD_BASE_SELECTOR
if [ -z "$DEEP_SELECTOR" ]; then prompt_selector deep 'openai-codex/gpt-6-astra' DEEP_SELECTOR; fi
parse_configured_selector deep "$DEEP_SELECTOR" DEEP_SELECTOR DEEP_BASE_SELECTOR

OPTIONAL_ROLES=(plan vision designer commit tiny task advisor)
OPTIONAL_SELECTORS=("" "" "" "" "" "" "")
if [ -t 0 ]; then
  while true; do
    printf 'Do you want to configure the optional models? [y/N] ' >/dev/tty
    if ! IFS= read -r answer </dev/tty; then
      log "${C_RED}omp-sbx-configure-models: failed to read from terminal${C_RST}"
      exit 1
    fi
    case "${answer,,}" in
      ''|n|no) break ;;
      q) log "${C_DIM}cancelled${C_RST}"; exit 0 ;;
      y|yes)
        log "Skip plan/advisor to retain tier defaults; skip task to preserve its saved role or use @default; skip other roles to preserve saved mappings or leave them unassigned."
        OPTIONAL_DESCRIPTIONS=(
          "plan: plan-mode architecture and review."
          "vision: image inspection requiring an image-capable model; optional when the main model handles images."
          "designer: designer subagent."
          "commit: commit-message generation."
          "tiny: very small classifications, titles, memory support and speech cleanup."
          "task: general subagent work when an agent does not request another model."
          "advisor: independent reasoning used by Advisor."
        )
        OPTIONAL_PREFERRED=("$STANDARD_BASE_SELECTOR" "" "$STANDARD_BASE_SELECTOR" "$FAST_BASE_SELECTOR" "$FAST_BASE_SELECTOR" "$STANDARD_BASE_SELECTOR" "$DEEP_BASE_SELECTOR")
        for index in "${!OPTIONAL_ROLES[@]}"; do
          log "${OPTIONAL_DESCRIPTIONS[index]}"
          prompt_selector "${OPTIONAL_ROLES[index]}" "${OPTIONAL_PREFERRED[index]}" "OPTIONAL_SELECTORS[$index]" true
        done
        break
        ;;
      *) log "Please answer y/yes, n/no, or q to cancel." ;;
    esac
  done
fi

ROLES_GET="$CAPTURE_DIR/modelRoles.get.json"
AGENTS_GET="$CAPTURE_DIR/agentModelOverrides.get.json"
STORAGE_GET="$CAPTURE_DIR/modelRoleStorage.get.json"
ROLES_ORIGINAL="$CAPTURE_DIR/modelRoles.original.json"
AGENTS_ORIGINAL="$CAPTURE_DIR/agentModelOverrides.original.json"
STORAGE_ORIGINAL="$CAPTURE_DIR/modelRoleStorage.original"
ROLES_MERGED="$CAPTURE_DIR/modelRoles.merged.json"
AGENTS_MERGED="$CAPTURE_DIR/agentModelOverrides.merged.json"
capture_staged_config "$ROLES_GET" get modelRoles --json
capture_staged_config "$AGENTS_GET" get task.agentModelOverrides --json
capture_staged_config "$STORAGE_GET" get modelRoleStorage --json
python3 - "$ROLES_GET" "$AGENTS_GET" "$STORAGE_GET" "$ROLES_ORIGINAL" "$AGENTS_ORIGINAL" "$STORAGE_ORIGINAL" <<'PY'
import json
import sys

roles_get, agents_get, storage_get, roles_original, agents_original, storage_original = sys.argv[1:]
def config_value(path, key):
    try:
        with open(path, encoding="utf-8") as stream:
            payload = json.load(stream)
    except (OSError, json.JSONDecodeError) as error:
        raise SystemExit(f"malformed config output for {key}: {error}")
    return payload.get("value") if isinstance(payload, dict) else None

def value_object(path, key):
    value = config_value(path, key)
    if not isinstance(value, dict):
        raise SystemExit(f"malformed config output for {key}: .value must be an object")
    return value
roles = value_object(roles_get, "modelRoles")
agents = value_object(agents_get, "task.agentModelOverrides")
storage = config_value(storage_get, "modelRoleStorage")
if storage not in ("global", "project"):
    raise SystemExit("malformed config output for modelRoleStorage: .value must be global or project")
with open(roles_original, "w", encoding="utf-8") as stream:
    json.dump(roles, stream, separators=(",", ":"), sort_keys=True)
with open(agents_original, "w", encoding="utf-8") as stream:
    json.dump(agents, stream, separators=(",", ":"), sort_keys=True)
with open(storage_original, "w", encoding="utf-8") as stream:
    stream.write(storage + "\n")
PY

INTENDED_CHANGES="$CAPTURE_DIR/intended-changes.json"
python3 - "$INTENDED_CHANGES" "$ROLES_ORIGINAL" "$FAST_SELECTOR" "$STANDARD_SELECTOR" "$DEEP_SELECTOR" "${OPTIONAL_SELECTORS[@]}" <<'PY'
import json
import sys

destination, roles_original, fast, standard, deep, *selectors = sys.argv[1:]
with open(roles_original, encoding="utf-8") as stream:
    saved_roles = json.load(stream)
roles = {"smol": fast, "default": standard, "plan": standard, "slow": deep, "advisor": deep,
         "task": saved_roles.get("task", "@default")}
agents = {"scout": "@smol", "sonic": "@smol", "task": "@task", "reviewer": "@slow", "security-reviewer": "@slow"}
for role, selector in zip(("plan", "vision", "designer", "commit", "tiny", "task", "advisor"), selectors):
    if selector:
        roles[role] = selector
        if role == "designer":
            agents[role] = f"@{role}"
with open(destination, "w", encoding="utf-8") as stream:
    json.dump({"roles": roles, "agents": agents, "modelRoleStorage": "project"}, stream, separators=(",", ":"))
PY
print_intended_changes() {
  python3 - "$INTENDED_CHANGES" <<'PY' >&2
import json
import sys

with open(sys.argv[1], encoding="utf-8") as stream:
    changes = json.load(stream)
for key in ("roles", "agents"):
    assignments = changes[key]
    print(f"  {key}: " + ", ".join(f"{role}={selector}" for role, selector in assignments.items()))
print("  Unrelated saved mappings are unchanged.")
print("  Thinking: :LEVEL is a role override; no suffix uses native inheritance.")
print("  Assignment scope: global (shared across omp-sbx sandboxes).")
print(f"  modelRoleStorage: {changes['modelRoleStorage']} (enables global/project saves in /model > Roles).")
print("  Project .omp/config.yml overrides matching global roles; project files are not changed.")
PY
}

log ""
log "Resolved model tiers:"
log "  fast:     $FAST_SELECTOR"
log "  standard: $STANDARD_SELECTOR"
log "  deep:     $DEEP_SELECTOR"
print_intended_changes
if [ "$DRY_RUN" = true ]; then
  log "  Host configuration: $HOST_CONFIG_FILE (not written by dry-run)."
  log "${C_GREEN}Dry run complete; configuration was not changed.${C_RST}"
  exit 0
fi

python3 - "$ROLES_ORIGINAL" "$AGENTS_ORIGINAL" "$ROLES_MERGED" "$AGENTS_MERGED" "$INTENDED_CHANGES" <<'PY'
import json
import sys

roles_original, agents_original, roles_merged, agents_merged, changes_path = sys.argv[1:]
with open(roles_original, encoding="utf-8") as stream:
    roles = json.load(stream)
with open(agents_original, encoding="utf-8") as stream:
    agents = json.load(stream)
with open(changes_path, encoding="utf-8") as stream:
    changes = json.load(stream)
roles.update(changes["roles"])
agents.update(changes["agents"])
with open(roles_merged, "w", encoding="utf-8") as stream:
    json.dump(roles, stream, separators=(",", ":"), sort_keys=True)
with open(agents_merged, "w", encoding="utf-8") as stream:
    json.dump(agents, stream, separators=(",", ":"), sort_keys=True)
PY

rollback() {
  local failed=false
  log "${C_YELLOW}Restoring previous model configuration...${C_RST}"
  if ! set_staged_config modelRoles "$(cat "$ROLES_ORIGINAL")"; then
    log "${C_RED}rollback failed for modelRoles${C_RST}"
    failed=true
  fi
  if ! set_staged_config task.agentModelOverrides "$(cat "$AGENTS_ORIGINAL")"; then
    log "${C_RED}rollback failed for task.agentModelOverrides${C_RST}"
    failed=true
  fi
  if ! set_staged_config modelRoleStorage "$(cat "$STORAGE_ORIGINAL")"; then
    log "${C_RED}rollback failed for modelRoleStorage${C_RST}"
    failed=true
  fi
  [ "$failed" = false ]
}
fail_and_rollback() {
  log "${C_RED}omp-sbx-configure-models: configuration update failed${C_RST}"
  rollback || log "${C_RED}omp-sbx-configure-models: rollback was incomplete${C_RST}"
  exit 1
}

if ! set_staged_config modelRoles "$(cat "$ROLES_MERGED")"; then
  fail_and_rollback
fi
if ! set_staged_config task.agentModelOverrides "$(cat "$AGENTS_MERGED")"; then
  fail_and_rollback
fi
if ! set_staged_config modelRoleStorage project; then
  fail_and_rollback
fi

ROLES_VERIFY="$CAPTURE_DIR/modelRoles.verify.json"
AGENTS_VERIFY="$CAPTURE_DIR/agentModelOverrides.verify.json"
STORAGE_VERIFY="$CAPTURE_DIR/modelRoleStorage.verify.json"
if ! capture_staged_config "$ROLES_VERIFY" get modelRoles --json ||
   ! capture_staged_config "$AGENTS_VERIFY" get task.agentModelOverrides --json ||
   ! capture_staged_config "$STORAGE_VERIFY" get modelRoleStorage --json ||
   ! python3 - "$ROLES_VERIFY" "$AGENTS_VERIFY" "$STORAGE_VERIFY" "$ROLES_MERGED" "$AGENTS_MERGED" <<'PY'
import json
import sys
roles_path, agents_path, storage_path, expected_roles_path, expected_agents_path = sys.argv[1:]
try:
    with open(roles_path, encoding="utf-8") as stream:
        roles = json.load(stream).get("value")
    with open(agents_path, encoding="utf-8") as stream:
        agents = json.load(stream).get("value")
    with open(storage_path, encoding="utf-8") as stream:
        storage = json.load(stream).get("value")
    with open(expected_roles_path, encoding="utf-8") as stream:
        expected_roles = json.load(stream)
    with open(expected_agents_path, encoding="utf-8") as stream:
        expected_agents = json.load(stream)
except (OSError, json.JSONDecodeError, AttributeError) as error:
    raise SystemExit(f"post-write verification output is malformed: {error}")
if roles != expected_roles:
    raise SystemExit("post-write verification failed for modelRoles")
if agents != expected_agents:
    raise SystemExit("post-write verification failed for task.agentModelOverrides")
if storage != "project":
    raise SystemExit("post-write verification failed for modelRoleStorage")
PY
then
  fail_and_rollback
fi
if [ ! -f "$STAGED_CONFIG_FILE" ]; then
  fail_and_rollback
fi
publish_host_config() {
  if [ ! -d "$HOST_CONFIG_DIR" ] && ! mkdir -m 700 -p "$HOST_CONFIG_DIR"; then
    return 1
  fi
  HOST_CONFIG_TEMP="$(mktemp "$HOST_CONFIG_DIR/.config.yml.XXXXXX")" || return 1
  if ! cp "$STAGED_CONFIG_FILE" "$HOST_CONFIG_TEMP" ||
     ! chmod 0600 "$HOST_CONFIG_TEMP" ||
     ! mv -f "$HOST_CONFIG_TEMP" "$HOST_CONFIG_FILE"
  then
    return 1
  fi
  HOST_CONFIG_TEMP=""
}
if ! publish_host_config; then
  fail_and_rollback
fi

log ""
log "${C_GREEN}Global OMP model routing updated.${C_RST}"
print_intended_changes
log "  host configuration: $HOST_CONFIG_FILE"
log "  The mounted global configuration is shared by all omp-sbx sandboxes."
log "  Restart an existing OMP process to load the updated startup configuration."
log "  Configuration complete; returning to the host without starting an OMP session."
exit 0
